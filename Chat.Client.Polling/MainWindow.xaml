<Window x:Class="Chat.Client.Polling.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Client (Polling)" Height="400" Width="400"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Chat.Client.Shared;component/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Chat.Client.Shared;component/Styles/Sizing.xaml"/>
                <ResourceDictionary Source="/Chat.Client.Shared;component/Resources/Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="COMP3008 Chat" FontSize="{StaticResource FontSizeHuge}" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,{StaticResource MarginExtraLarge}"/>
            <TextBlock Text="Username:" FontSize="{StaticResource FontSizeMedium}" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameTextBox" FontSize="{StaticResource FontSizeMedium}" Padding="{StaticResource PaddingNormal}" Margin="0,0,0,20"
                     Background="{StaticResource SecondaryBackgroundBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                     KeyDown="UsernameTextBox_KeyDown"/>
            <Button x:Name="SignInButton" Content="Sign In" FontSize="{StaticResource FontSizeMedium}" Padding="{StaticResource ButtonPaddingNormal}" Margin="0,0,0,10"
                    Background="{StaticResource AccentBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0"
                    Cursor="Hand" Click="SignInButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock x:Name="LoginStatusText" FontSize="{StaticResource FontSizeNormal}" Foreground="{StaticResource ErrorBrush}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" Height="40"/>
        </StackPanel>
    </Grid>
</Window>
