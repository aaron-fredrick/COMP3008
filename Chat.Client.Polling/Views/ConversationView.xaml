<Window x:Class="Chat.Client.Polling.Views.ConversationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Chat.Client.Polling.Views"
        Title="Conversation" Height="600" Width="1000"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Chat.Client.Shared;component/Styles/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <TextBlock x:Name="ChannelNameText" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,20" TextWrapping="Wrap"/>

                <TextBlock Text="Members" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10"/>
                <ListBox x:Name="MembersListBox" Background="{StaticResource SecondaryBackgroundBrush}"
                         Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" Height="200"
                         MouseDoubleClick="MembersListBox_MouseDoubleClick"/>

                <TextBlock Text="Shared Files" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource ForegroundBrush}" Margin="0,20,0,10"/>
                <ListBox x:Name="FilesListBox" Background="{StaticResource SecondaryBackgroundBrush}"
                         Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" Height="120"
                         MouseDoubleClick="FilesListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource ForegroundBrush}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Foreground="#aaaaaa" FontSize="10">
                                    <Run Text="{Binding UploaderId}"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding UploadedAt, StringFormat='{}{0:HH:mm}'}"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button x:Name="ShareFileButton" Content="Share File" FontSize="12" Padding="8" Margin="0,10,0,0"
                        Background="{StaticResource AccentBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0"
                        Cursor="Hand" Click="ShareFileButton_Click"/>

                <Button x:Name="LeaveButton" Content="Leave Channel" FontSize="12" Padding="8" Margin="0,20,0,0"
                        Background="{StaticResource ErrorBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0"
                        Cursor="Hand" Click="LeaveButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Chat Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Messages -->
            <ListBox x:Name="MessagesListBox" Grid.Row="0" Background="{StaticResource BackgroundBrush}"
                     Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="10"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            <!-- Input Area -->
            <Border Grid.Row="1" Background="{StaticResource SecondaryBackgroundBrush}" Padding="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageTextBox" Grid.Column="0" FontSize="14" Padding="8"
                             Background="{StaticResource SecondaryBackgroundBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    <Button x:Name="SendButton" Grid.Column="1" Content="Send" FontSize="14" Padding="15,8"
                            Background="{StaticResource AccentBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0"
                            Cursor="Hand" Margin="10,0,0,0" Click="SendButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
