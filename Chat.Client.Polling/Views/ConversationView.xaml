<Window x:Class="Chat.Client.Polling.Views.ConversationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conversation" Height="600" Width="1000"
        Background="#1e1e1e"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#252526" BorderBrush="#404040" BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <TextBlock x:Name="ChannelNameText" FontSize="16" FontWeight="Bold" 
                           Foreground="#00bcd4" Margin="0,0,0,20" TextWrapping="Wrap"/>
                
                <TextBlock Text="Members" FontSize="14" FontWeight="Bold" 
                           Foreground="#ffffff" Margin="0,0,0,10"/>
                <ListBox x:Name="MembersListBox" Background="#2d2d2d" 
                         Foreground="#ffffff" BorderBrush="#404040" Height="200"
                         MouseDoubleClick="MembersListBox_MouseDoubleClick"/>
                
                <TextBlock Text="Shared Files" FontSize="14" FontWeight="Bold" 
                           Foreground="#ffffff" Margin="0,20,0,10"/>
                <ListBox x:Name="FilesListBox" Background="#2d2d2d" 
                         Foreground="#ffffff" BorderBrush="#404040" Height="120"
                         MouseDoubleClick="FilesListBox_MouseDoubleClick"
                         DisplayMemberPath="FileName"/>
                
                <Button x:Name="ShareFileButton" Content="Share File" FontSize="12" Padding="8" Margin="0,10,0,0"
                        Background="#00bcd4" Foreground="#ffffff" BorderThickness="0"
                        Cursor="Hand" Click="ShareFileButton_Click"/>
                
                <Button x:Name="LeaveButton" Content="Leave Channel" FontSize="12" Padding="8" Margin="0,20,0,0"
                        Background="#ff5252" Foreground="#ffffff" BorderThickness="0"
                        Cursor="Hand" Click="LeaveButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Chat Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Messages -->
            <ListBox x:Name="MessagesListBox" Grid.Row="0" Background="#1e1e1e" 
                     Foreground="#ffffff" BorderBrush="#404040" Padding="10"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            <!-- Input Area -->
            <Border Grid.Row="1" Background="#252526" Padding="10" BorderBrush="#404040" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageTextBox" Grid.Column="0" FontSize="14" Padding="8"
                             Background="#2d2d2d" Foreground="#ffffff" BorderBrush="#404040"/>
                    <Button x:Name="SendButton" Grid.Column="1" Content="Send" FontSize="14" Padding="15,8"
                            Background="#00bcd4" Foreground="#ffffff" BorderThickness="0"
                            Cursor="Hand" Margin="10,0,0,0" Click="SendButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
