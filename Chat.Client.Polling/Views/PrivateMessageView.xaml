<Window x:Name="Root" x:Class="Chat.Client.Polling.Views.PrivateMessageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Chat.Client.Shared.Controls;assembly=Chat.Client.Shared"
        Title="Private Message" Height="432" Width="520"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">
    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource WindowBorderBrush}"
            BorderThickness="{StaticResource WindowBorderThickness}"
            CornerRadius="{StaticResource WindowCornerRadius}">
        <Border.Effect>
            <DropShadowEffect Color="{StaticResource WindowShadowColor}"
                              BlurRadius="{StaticResource WindowShadowDepth}"
                              ShadowDepth="{StaticResource WindowShadowDepth}"
                              Direction="270"
                              Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <controls:CustomTitleBar Grid.Row="0"/>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        Background="{StaticResource SecondaryBackgroundBrush}" Padding="20,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{StaticResource AvatarBackgroundBrush}" Margin="0,0,12,0">
                                    <Canvas Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{Binding RecipientId, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToRibbonPathConverter}}"
                                              Stroke="{StaticResource AvatarTextBrush}"
                                              StrokeThickness="1.8"
                                              Fill="Transparent"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="RecipientText" Text="Private Conversation"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Direct Message" FontSize="11"
                                       Foreground="{StaticResource MessageMetadataBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Messages -->
                <ListBox Grid.Row="1" x:Name="MessagesListBox"
                         Background="{StaticResource BackgroundBrush}"
                         Foreground="{StaticResource ForegroundBrush}"
                         BorderThickness="0" Padding="16,12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0,3"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource IsCurrentUserConverter}">
                                                        <Binding Path="SenderId"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=ListBox}" Path="Tag"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock FontSize="10" Foreground="{StaticResource MessageMetadataBrush}" Margin="0,0,0,3">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource IsCurrentUserConverter}">
                                                            <Binding Path="SenderId"/>
                                                            <Binding RelativeSource="{RelativeSource AncestorType=ListBox}" Path="Tag"/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding SenderId}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"/>
                                </TextBlock>
                                <Border Padding="10,10" CornerRadius="12"
                                        Background="{StaticResource MessageBubbleOtherBrush}"
                                        MaxWidth="380">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource IsCurrentUserConverter}">
                                                            <Binding Path="SenderId"/>
                                                            <Binding RelativeSource="{RelativeSource AncestorType=ListBox}" Path="Tag"/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="{StaticResource MessageBubbleOwnBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap"
                                               Foreground="{StaticResource MessageTextOtherBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource IsCurrentUserConverter}">
                                                                <Binding Path="SenderId"/>
                                                                <Binding RelativeSource="{RelativeSource AncestorType=ListBox}" Path="Tag"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Foreground" Value="{StaticResource MessageTextOwnBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Input Area -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Background="{StaticResource InputAreaBackgroundBrush}" Padding="12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <TextBox x:Name="MessageTextBox" FontSize="13" Padding="11,11"
                                     Background="Transparent" Foreground="{StaticResource ForegroundBrush}"
                                     BorderThickness="0" CaretBrush="{StaticResource ForegroundBrush}"
                                     KeyDown="MessageTextBox_KeyDown"/>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource MessageBubbleOwnBrush}"
                                CornerRadius="9" Margin="9,0,0,0">
                            <Button x:Name="SendButton" Content="Send" FontSize="13" FontWeight="650"
                                    Foreground="{StaticResource MessageTextOwnBrush}" Cursor="Hand"
                                    Click="SendButton_Click"
                                    Background="Transparent" BorderThickness="0" Padding="14,11"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

