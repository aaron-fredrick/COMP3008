<Window x:Class="Chat.Client.Polling.Views.PrivateMessageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Private Message" Height="400" Width="500"
        Background="#1e1e1e" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" x:Name="RecipientText" 
                   Text="Private Conversation with: User" 
                   Foreground="#ffffff" FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Messages -->
        <ListBox Grid.Row="1" x:Name="MessagesListBox" 
                 Background="#2d2d2d" Foreground="#ffffff" 
                 BorderBrush="#404040" BorderThickness="1"
                 Margin="0,0,0,10"/>

        <!-- Input -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="MessageTextBox" 
                     Background="#2d2d2d" Foreground="#ffffff" 
                     BorderBrush="#404040" BorderThickness="1"
                     Padding="5" Margin="0,0,10,0"/>

            <Button Grid.Column="1" x:Name="SendButton" Content="Send" 
                    Background="#00bcd4" Foreground="#ffffff" 
                    BorderThickness="0" Padding="15,5" 
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
