<UserControl x:Class="Chat.Client.Polling.Views.ChannelListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:Chat.Client.Shared.Helpers;assembly=Chat.Client.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Sign Out Button -->
            <Button x:Name="SignOutButton" Grid.Column="0" Width="40" Height="40" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Padding="6" Margin="0,0,16,0" Click="SignOutButton_Click" ToolTip="Sign Out" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ErrorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Path Fill="{StaticResource ForegroundBrush}" Stretch="Uniform" Width="20" Height="20"
                      Data="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Channels" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}"/>
                <TextBlock Text="Choose a channel to join the conversation." FontSize="12" Foreground="#747982" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <!-- View Toggle -->
                <Border Background="{StaticResource SecondaryBackgroundBrush}" Padding="3" CornerRadius="9">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="GridViewButton" Width="36" Height="32" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Padding="0" Click="GridViewButton_Click" ToolTip="Grid View">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonBorder" Background="{StaticResource BorderBrush}" CornerRadius="7">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="#4a4a4a"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="▦" FontSize="17" Foreground="#777c84"/>
                        </Button>
                        <Button x:Name="ListViewButton" Width="36" Height="32" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Padding="0" Margin="3,0,0,0" Click="ListViewButton_Click" ToolTip="List View">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonBorder" Background="Transparent" CornerRadius="7">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="#4a4a4a"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="☰" FontSize="17" Foreground="#777c84"/>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Search -->
        <Border Grid.Row="1" Margin="0,0,0,18">
            <Border Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Icon -->
                    <Path Grid.Column="0" Fill="{StaticResource ForegroundBrush}" Opacity="0.5" Width="18" Height="18" Margin="0,0,10,0"
                          Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Stretch="Uniform"/>

                    <!-- Search Input -->
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchTextBox" FontSize="14" Padding="0" 
                                 Background="Transparent" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0"
                                 TextChanged="SearchTextBox_TextChanged" VerticalAlignment="Center"
                                 CaretBrush="{StaticResource ForegroundBrush}"/>
                        
                        <!-- Placeholder -->
                        <TextBlock Text="Search channels..." FontSize="14" Foreground="{StaticResource ForegroundBrush}" Opacity="0.4"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,0,1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=SearchTextBox}" Value=""/>
                                                <Condition Binding="{Binding IsFocused, ElementName=SearchTextBox}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Channels Grid View -->
        <ItemsControl x:Name="ChannelsGrid" Grid.Row="2" Loaded="ChannelsGrid_Loaded" SizeChanged="ChannelsGrid_SizeChanged">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding GridColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="-6,0,0,0" VerticalAlignment="Top"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="6,0,0,12"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" 
                            Padding="12,12" Cursor="Hand" MouseLeftButtonUp="ChannelCard_MouseLeftButtonUp"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="{StaticResource WindowShadowColor}" BlurRadius="14" ShadowDepth="4" Opacity="0.2"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center">
                                <Run Text="#" Foreground="{StaticResource AccentBrush}" FontWeight="Medium"/>
                                <Run Text="{Binding Name}"/>
                            </TextBlock>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FF4CAF50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UserCount}" Value="0">
                                                    <Setter Property="Fill" Value="#FFF44336"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UserCount}" Value="1">
                                                    <Setter Property="Fill" Value="#FFFF9800"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="12" Foreground="{StaticResource ForegroundBrush}" Opacity="0.7" Margin="6,0,0,0">
                                    <Run Text="{Binding UserCount}"/>
                                    <Run Text=" active"/>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="2" Content="Join" Foreground="{StaticResource ForegroundBrush}" 
                                    BorderThickness="0" Padding="14,6" FontSize="12" FontWeight="SemiBold"
                                    Cursor="Hand" Click="JoinButton_Click" Tag="{Binding Name}" 
                                    Background="#FF4A4A4A" helpers:ControlHelper.CornerRadius="6" Margin="16,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Channels List View (Hidden by default) -->
        <ItemsControl x:Name="ChannelsList" Grid.Row="2" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" 
                            Padding="12,15" Margin="0,0,0,7" Cursor="Hand" MouseLeftButtonUp="ChannelCard_MouseLeftButtonUp">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="{StaticResource WindowShadowColor}" BlurRadius="14" ShadowDepth="4" Opacity="0.2"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center">
                                <Run Text="#" Foreground="{StaticResource AccentBrush}" FontWeight="Medium"/>
                                <Run Text="{Binding Name}"/>
                            </TextBlock>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FF4CAF50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UserCount}" Value="0">
                                                    <Setter Property="Fill" Value="#FFF44336"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UserCount}" Value="1">
                                                    <Setter Property="Fill" Value="#FFFF9800"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="12" Foreground="{StaticResource ForegroundBrush}" Opacity="0.7" Margin="6,0,0,0">
                                    <Run Text="{Binding UserCount}"/>
                                    <Run Text=" active"/>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="2" Content="Join" Foreground="{StaticResource ForegroundBrush}" 
                                    BorderThickness="0" Padding="14,6" FontSize="12" FontWeight="SemiBold"
                                    Cursor="Hand" Click="JoinButton_Click" Tag="{Binding Name}" 
                                    Background="#FF4A4A4A" helpers:ControlHelper.CornerRadius="6" Margin="16,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Create Channel Panel -->
        <Border Grid.Row="3" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                CornerRadius="11" Padding="16" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="Create a new channel" FontSize="14" FontWeight="SemiBold" 
                           Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,12"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="9*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Height="36" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <TextBox x:Name="NewChannelTextBox" FontSize="13" Padding="12,0"
                                     Background="Transparent" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0"
                                     CaretBrush="{StaticResource ForegroundBrush}" VerticalContentAlignment="Center"
                                     TextChanged="NewChannelTextBox_TextChanged"/>
                            <TextBlock Text="Enter channel name..." FontSize="13" Padding="12,0"
                                       Foreground="{StaticResource ForegroundBrush}" Opacity="0.5" IsHitTestVisible="False"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=NewChannelTextBox}" Value=""/>
                                                    <Condition Binding="{Binding IsFocused, ElementName=NewChannelTextBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    
                    <Button x:Name="CreateChannelButton" Grid.Column="2" Height="36" Content="Create" Foreground="{StaticResource ForegroundBrush}" 
                            BorderThickness="0" Padding="16,0" FontSize="13" FontWeight="SemiBold"
                            Cursor="Hand" Click="CreateChannelButton_Click" Background="{StaticResource AccentBrush}"
                            helpers:ControlHelper.CornerRadius="6"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
