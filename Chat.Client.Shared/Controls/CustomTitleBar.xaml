<UserControl x:Class="Chat.Client.Shared.Controls.CustomTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="400"
             Height="40">
    <Border Background="{Binding BackgroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" CornerRadius="8,8,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

        <!-- Title -->
        <TextBlock x:Name="TitleText" 
                   Grid.Column="0"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   FontSize="{StaticResource FontSizeNormal}"
                   FontWeight="Medium"
                   Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"
                   MouseLeftButtonDown="TitleText_MouseLeftButtonDown"/>

        <!-- Window Controls -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="MinimizeButton" 
                    Width="46" 
                    Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="MinimizeButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="Transparent" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#39393C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Path Data="M0,8 L12,8" 
                      Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                      StrokeThickness="1.5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Button>

            <Button x:Name="MaximizeButton" 
                    Width="46" 
                    Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="MaximizeButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="Transparent" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#39393C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Path Data="M2,2 L10,2 L10,10 L2,10 Z" 
                      Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                      StrokeThickness="1.5"
                      Fill="Transparent"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Button>

            <Button x:Name="CloseButton" 
                    Width="46" 
                    Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="Transparent" Padding="0" CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Path x:Name="CloseButtonPath" Data="M0,0 L10,10 M10,0 L0,10" 
                      Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                      StrokeThickness="1.5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                    <Setter Property="Stroke" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Button>
        </StackPanel>
        </Grid>
    </Border>
</UserControl>
