<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:converters="clr-namespace:Chat.Client.Shared.Converters;assembly=Chat.Client.Shared">

    <!-- Converters -->
    <converters:FileSizeConverter x:Key="FileSizeConverter"/>

    <!-- Dark Theme Colors -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1e1e1e"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#2d2d2d"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#404040"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#00bcd4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#00acc1"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#ff5252"/>

    <!-- Color Values -->
    <Color x:Key="BackgroundColor">#1e1e1e</Color>
    <Color x:Key="SecondaryBackgroundColor">#2d2d2d</Color>
    <Color x:Key="BorderColor">#404040</Color>
    <Color x:Key="ForegroundColor">#ffffff</Color>
    <Color x:Key="AccentColor">#00bcd4</Color>
    <Color x:Key="AccentHoverColor">#00acc1</Color>
    <Color x:Key="ErrorColor">#ff5252</Color>

    <!-- Font Sizes -->
    <sys:Double x:Key="FontSizeSmall">10</sys:Double>
    <sys:Double x:Key="FontSizeNormal">12</sys:Double>
    <sys:Double x:Key="FontSizeMedium">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeExtraLarge">24</sys:Double>
    <sys:Double x:Key="FontSizeHuge">28</sys:Double>

    <!-- Padding -->
    <Thickness x:Key="PaddingSmall">5</Thickness>
    <Thickness x:Key="PaddingNormal">8</Thickness>
    <Thickness x:Key="PaddingMedium">10</Thickness>
    <Thickness x:Key="PaddingLarge">15</Thickness>
    <Thickness x:Key="PaddingExtraLarge">20</Thickness>

    <!-- Margins -->
    <Thickness x:Key="MarginSmall">5</Thickness>
    <Thickness x:Key="MarginNormal">10</Thickness>
    <Thickness x:Key="MarginMedium">15</Thickness>
    <Thickness x:Key="MarginLarge">20</Thickness>
    <Thickness x:Key="MarginExtraLarge">30</Thickness>

    <!-- Button Padding -->
    <Thickness x:Key="ButtonPaddingSmall">8</Thickness>
    <Thickness x:Key="ButtonPaddingNormal">10</Thickness>
    <Thickness x:Key="ButtonPaddingLarge">15,8</Thickness>

</ResourceDictionary>
