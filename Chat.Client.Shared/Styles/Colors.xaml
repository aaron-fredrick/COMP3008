<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:System="clr-namespace:System;assembly=mscorlib">

    <!-- Dark Theme Colors -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1e1e1e"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#2d2d2d"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#404040"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#00bcd4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#00acc1"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0097a7"/>
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#555555"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#ff5252"/>

    <!-- Chat UI Colors -->
    <SolidColorBrush x:Key="HashSymbolBrush" Color="#8b9098"/>
    <SolidColorBrush x:Key="AvatarBackgroundBrush" Color="#e1e3e7"/>
    <SolidColorBrush x:Key="AvatarTextBrush" Color="#555b64"/>
    <SolidColorBrush x:Key="OnlineIndicatorBrush" Color="#35a853"/>
    <SolidColorBrush x:Key="OnlineIndicatorStrokeBrush" Color="#f8f9fa"/>
    <SolidColorBrush x:Key="MessageBubbleOtherBrush" Color="#2d2d2d"/>
    <SolidColorBrush x:Key="MessageBubbleOwnBrush" Color="#005c4b"/>
    <SolidColorBrush x:Key="MessageTextOtherBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="MessageTextOwnBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="MessageMetadataBrush" Color="#8a8f98"/>
    <SolidColorBrush x:Key="InputAreaBackgroundBrush" Color="#2d2d2d"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#404040"/>
    <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#888888"/>
    <SolidColorBrush x:Key="FileIconBackgroundBrush" Color="#eceef1"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#888888"/>
    <SolidColorBrush x:Key="SecondaryTextDarkBrush" Color="#c0c3c8"/>
    <SolidColorBrush x:Key="LightBorderBrush" Color="#dedfe3"/>

    <!-- Window Chrome Resources -->
    <CornerRadius x:Key="WindowCornerRadius">8</CornerRadius>
    <Thickness x:Key="WindowBorderThickness">1</Thickness>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#3a3a3a"/>
    <System:Double x:Key="WindowShadowDepth">8</System:Double>
    <Color x:Key="WindowShadowColor">#000000</Color>

    <!-- Light Theme Colors (for reference) -->
    <Color x:Key="LightBackgroundColor">#ffffff</Color>
    <Color x:Key="LightSecondaryBackgroundColor">#f5f5f5</Color>
    <Color x:Key="LightBorderColor">#e0e0e0</Color>
    <Color x:Key="LightForegroundColor">#000000</Color>
    <Color x:Key="LightAccentColor">#00bcd4</Color>
    <Color x:Key="LightAccentHoverColor">#00acc1</Color>
    <Color x:Key="LightAccentPressedColor">#0097a7</Color>
    <Color x:Key="LightAccentDisabledColor">#cccccc</Color>
    <Color x:Key="LightErrorColor">#ff5252</Color>

    <!-- Color Values -->
    <Color x:Key="BackgroundColor">#1e1e1e</Color>
    <Color x:Key="SecondaryBackgroundColor">#2d2d2d</Color>
    <Color x:Key="BorderColor">#404040</Color>
    <Color x:Key="ForegroundColor">#ffffff</Color>
    <Color x:Key="AccentColor">#00bcd4</Color>
    <Color x:Key="AccentHoverColor">#00acc1</Color>
    <Color x:Key="AccentPressedColor">#0097a7</Color>
    <Color x:Key="AccentDisabledColor">#555555</Color>
    <Color x:Key="ErrorColor">#ff5252</Color>

</ResourceDictionary>
