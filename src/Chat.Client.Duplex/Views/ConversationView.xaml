<UserControl x:Name="Root" x:Class="Chat.Client.Duplex.Views.ConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Chat.Client.Shared.Controls;assembly=Chat.Client.Shared"
             xmlns:helpers="clr-namespace:Chat.Client.Shared.Helpers;assembly=Chat.Client.Shared"
             mc:Ignorable="d"
             d:DesignHeight="664" d:DesignWidth="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Left Sidebar — Members ═══ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="20,14">
                <StackPanel Orientation="Horizontal" Margin="0,8,0,20" VerticalAlignment="Center">
                    <TextBlock Text="# " FontSize="15" FontWeight="Bold" Foreground="{StaticResource HashSymbolBrush}"/>
                    <TextBlock x:Name="ChannelNameSidebar" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource ForegroundBrush}"/>
                </StackPanel>

                <TextBlock x:Name="MembersSectionText" Text="MEMBERS — 0" FontSize="11"
                           Foreground="{StaticResource MessageMetadataBrush}" FontWeight="Bold" Margin="0,20,0,8"/>
                <ListBox x:Name="MembersListBox" Background="{StaticResource SidebarBackgroundBrush}"
                         Foreground="{StaticResource ForegroundBrush}" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="MembersListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="8" Background="Transparent">
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{StaticResource AvatarBackgroundBrush}" Margin="0,0,9,0">
                                    <Canvas Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{Binding Converter={StaticResource StringToRibbonPathConverter}}"
                                              StrokeThickness="1.8" Fill="Transparent"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="{StaticResource AvatarTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource IsCurrentUserConverter}">
                                                                    <Binding/>
                                                                    <Binding Path="CurrentUserId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Stroke" Value="{StaticResource MessageBubbleOwnBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Canvas>
                                </Border>
                                <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="CHANNEL" FontSize="11"
                           Foreground="{StaticResource MessageMetadataBrush}" FontWeight="Bold" Margin="0,20,0,8"/>
                <Button x:Name="LeaveChannelSidebarButton" Content="↩ Leave channel"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource ForegroundBrush}"
                        HorizontalAlignment="Left" Padding="8" Click="LeaveButton_Click"/>
                <Button x:Name="ExportChatButton" Content="↓ Export chat"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource ForegroundBrush}"
                        HorizontalAlignment="Left" Padding="8" Margin="0,2,0,0" Click="ExportChatButton_Click"/>
            </StackPanel>
        </Border>

        <!-- ═══ Center — Chat Area ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Height="64" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Background="{StaticResource BackgroundBrush}" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Leave / back button -->
                    <Button x:Name="LeaveButton" Grid.Column="0" Width="40" Height="40"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="6" Click="LeaveButton_Click"
                            ToolTip="Leave Channel" Margin="0,0,12,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ErrorBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Fill="{StaticResource ForegroundBrush}" Stretch="Uniform" Width="20" Height="20"
                              Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="# " FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource HashSymbolBrush}"/>
                        <TextBlock x:Name="ChannelNameText" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource ForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Messages -->
            <ListBox x:Name="MessagesListBox" Grid.Row="1"
                     Background="{StaticResource BackgroundBrush}"
                     Foreground="{StaticResource ForegroundBrush}"
                     BorderThickness="0" Padding="22,24,22,4"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.ScrollChanged="MessagesListBox_ScrollChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MaxWidth="500">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="Margin" Value="0,16,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowMetadata}" Value="False">
                                            <Setter Property="Margin" Value="0,4,0,0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrentUser}" Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar -->
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                    Background="{StaticResource AvatarBackgroundBrush}"
                                    Margin="0,0,9,0" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentUser}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShowMetadata}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Canvas Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{Binding SenderId, Converter={StaticResource StringToRibbonPathConverter}}"
                                          StrokeThickness="1.8" Fill="Transparent"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Stroke" Value="{StaticResource AvatarTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentUser}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource MessageBubbleOwnBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Canvas>
                            </Border>

                            <!-- Content -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding HeaderText}" FontSize="11" Foreground="{StaticResource MessageMetadataBrush}" Margin="0,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowMetadata}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Padding="10,13" CornerRadius="13"
                                        Background="{StaticResource MessageBubbleOtherBrush}" MaxWidth="400">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource MessageBubbleOtherBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentUser}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource MessageBubbleOwnBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource MessageBubbleOwnBrush}"/>
                                                    <Setter Property="CornerRadius" Value="13,13,4,13"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap"
                                                   TextBlock.LineHeight="18">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MessageTextOtherBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentUser}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource MessageTextOwnBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- File attachment card (only shown for file messages) -->
                                        <Border Visibility="{Binding Type, Converter={StaticResource FileTypeVisibilityConverter}}"
                                                Margin="0,8,0,0" Padding="10,12" CornerRadius="10"
                                                BorderBrush="{StaticResource LightBorderBrush}" BorderThickness="1"
                                                Background="{StaticResource BackgroundBrush}" MinWidth="220" Cursor="Hand"
                                                MouseLeftButtonUp="FileMessage_MouseLeftButtonUp">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentUser}" Value="True">
                                                            <Setter Property="Background" Value="#34373d"/>
                                                            <Setter Property="BorderBrush" Value="#454950"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="34" Height="34" CornerRadius="8"
                                                        Background="{StaticResource FileIconBackgroundBrush}" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Type, Converter={StaticResource MessageTypeToFileTypeConverter}}"
                                                               FontSize="12" FontWeight="Bold"
                                                               Foreground="{StaticResource AvatarTextBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Content, Converter={StaticResource FileNameExtractorConverter}}"
                                                               FontWeight="650" FontSize="12"
                                                               Foreground="{StaticResource ForegroundBrush}"/>
                                                    <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                                                               Margin="0,2,0,0" Text="Shared file"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Input Area -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Background="{StaticResource InputAreaBackgroundBrush}" Padding="12,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- File share button (+) -->
                    <Button x:Name="ShareFileButton" Grid.Column="0" Width="36" Height="36" Content="+" FontSize="18"
                            Foreground="{StaticResource ForegroundBrush}" Cursor="Hand" Click="ShareFileButton_Click"
                            Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                            helpers:ControlHelper.CornerRadius="9" Margin="0,0,9,0"/>

                    <!-- Message text box -->
                    <Border x:Name="MessageTextBoxBorder" Grid.Column="1" MinHeight="36" Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <TextBox x:Name="MessageTextBox" FontSize="13" Padding="11,0"
                                 Background="Transparent" Foreground="{StaticResource ForegroundBrush}"
                                 BorderThickness="0" CaretBrush="{StaticResource ForegroundBrush}"
                                 VerticalContentAlignment="Center"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 KeyDown="MessageTextBox_KeyDown" TextChanged="MessageTextBox_TextChanged"/>
                    </Border>

                    <!-- Send button -->
                    <Button x:Name="SendButton" Grid.Column="2" Height="36" Content="Send" FontSize="13" FontWeight="650"
                            Foreground="{StaticResource MessageTextOwnBrush}" Cursor="Hand" Click="SendButton_Click"
                            Background="{StaticResource MessageBubbleOwnBrush}" BorderThickness="0" Padding="16,0"
                            helpers:ControlHelper.CornerRadius="9" Margin="9,0,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Right Sidebar — Shared Files ═══ -->
        <Border Grid.Column="2" Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Shared Files" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource ForegroundBrush}" Margin="0,8,0,18"/>
                <Grid Grid.Row="1">
                    <TextBlock x:Name="NoFilesText" Text="No shared files yet" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>
                    <ListBox x:Name="FilesListBox" Background="{StaticResource SidebarBackgroundBrush}"
                             Foreground="{StaticResource ForegroundBrush}" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="FilesListBox_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                            Background="{StaticResource FileIconBackgroundBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding FileType, Converter={StaticResource FileTypeConverter}}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource AvatarTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="650" FontSize="12"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding UploaderId}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
