<Window
    x:Class="Chat.Client.Duplex.Views.PrivateMessageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Chat.Client.Shared.Controls;assembly=Chat.Client.Shared"
    xmlns:helpers="clr-namespace:Chat.Client.Shared.Helpers;assembly=Chat.Client.Shared"
    x:Name="Root"
    Title="Private Message (Duplex)"
    Width="760"
    Height="560"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Border
        Background="{StaticResource BackgroundBrush}"
        BorderBrush="{StaticResource WindowBorderBrush}"
        BorderThickness="{StaticResource WindowBorderThickness}"
        CornerRadius="{StaticResource WindowCornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:CustomTitleBar Grid.Row="0" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Padding="20,14"
                        Background="{StaticResource SecondaryBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="32"
                                Height="32"
                                Margin="0,0,12,0"
                                Background="{StaticResource AvatarBackgroundBrush}"
                                CornerRadius="16">
                                <Canvas Width="28" Height="28">
                                    <Path
                                        Data="{Binding RecipientId, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToRibbonPathConverter}}"
                                        Fill="Transparent"
                                        Stroke="{StaticResource AvatarTextBrush}"
                                        StrokeThickness="1.8" />
                                </Canvas>
                            </Border>
                            <StackPanel>
                                <TextBlock
                                    x:Name="RecipientText"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ForegroundBrush}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource MessageMetadataBrush}"
                                    Text="Direct Message" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ListBox
                        x:Name="MessagesListBox"
                        Grid.Row="1"
                        Padding="20,16"
                        Background="{StaticResource BackgroundBrush}"
                        BorderThickness="0"
                        Foreground="{StaticResource ForegroundBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource MessageMetadataBrush}"
                                        Text="{Binding HeaderText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowMetadata}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border
                                        Padding="10,11"
                                        Background="{StaticResource MessageBubbleOtherBrush}"
                                        CornerRadius="13">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentUser}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource MessageBubbleOwnBrush}" />
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock
                                            Foreground="{StaticResource MessageTextOtherBrush}"
                                            Text="{Binding Content}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border
                        Grid.Row="2"
                        Padding="12"
                        Background="{StaticResource InputAreaBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="MessageTextBox"
                                Grid.Column="0"
                                Padding="11"
                                Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}"
                                Foreground="{StaticResource ForegroundBrush}"
                                KeyDown="MessageTextBox_KeyDown" />
                            <Button
                                Grid.Column="1"
                                Margin="9,0,0,0"
                                Padding="14,10"
                                helpers:ControlHelper.CornerRadius="9"
                                Background="{StaticResource MessageBubbleOwnBrush}"
                                BorderThickness="0"
                                Click="SendButton_Click"
                                Content="Send"
                                Foreground="{StaticResource MessageTextOwnBrush}" />
                        </Grid>
                    </Border>
                </Grid>
                <Border
                    Grid.Column="1"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                    <DockPanel Margin="18,14">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="{StaticResource ForegroundBrush}"
                                Text="Shared Files" />
                            <TextBlock
                                Margin="0,3,0,12"
                                FontSize="10"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="PM file transfer UI" />
                            <Button
                                Padding="8,6"
                                helpers:ControlHelper.CornerRadius="8"
                                Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}"
                                Click="UploadFileButton_Click"
                                Content="+ Upload file"
                                Foreground="{StaticResource ForegroundBrush}" />
                            <Button
                                Margin="0,6,0,0"
                                Padding="8,6"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="ExportChatButton_Click"
                                Content="↓ Export chat"
                                Foreground="{StaticResource ForegroundBrush}" />
                        </StackPanel>
                        <ListBox
                            x:Name="FilesListBox"
                            Margin="0,14,0,0"
                            Background="{StaticResource SidebarBackgroundBrush}"
                            BorderThickness="0"
                            ItemsSource="{Binding PendingFiles, ElementName=Root}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5,7">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource ForegroundBrush}"
                                            Text="{Binding FileName}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="Pending server support" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
