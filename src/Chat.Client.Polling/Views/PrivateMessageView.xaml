<Window
    x:Class="Chat.Client.Polling.Views.PrivateMessageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Chat.Client.Shared.Controls;assembly=Chat.Client.Shared"
    xmlns:helpers="clr-namespace:Chat.Client.Shared.Helpers;assembly=Chat.Client.Shared"
    x:Name="Root"
    Title="Private Message"
    Width="760"
    Height="560"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Border
        Background="{StaticResource BackgroundBrush}"
        BorderBrush="{StaticResource WindowBorderBrush}"
        BorderThickness="{StaticResource WindowBorderThickness}"
        CornerRadius="{StaticResource WindowCornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:CustomTitleBar Grid.Row="0" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Padding="20,14"
                        Background="{StaticResource SecondaryBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="32"
                                Height="32"
                                Margin="0,0,12,0"
                                Background="{StaticResource AvatarBackgroundBrush}"
                                CornerRadius="16">
                                <Canvas Width="28" Height="28">
                                    <Path
                                        Data="{Binding RecipientId, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToRibbonPathConverter}}"
                                        Fill="Transparent"
                                        Stroke="{StaticResource AvatarTextBrush}"
                                        StrokeThickness="1.8" />
                                </Canvas>
                            </Border>
                            <StackPanel>
                                <TextBlock
                                    x:Name="RecipientText"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ForegroundBrush}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource MessageMetadataBrush}"
                                    Text="Direct Message" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ListBox
                        x:Name="MessagesListBox"
                        Grid.Row="1"
                        Padding="20,16"
                        Background="{StaticResource BackgroundBrush}"
                        BorderThickness="0"
                        Foreground="{StaticResource ForegroundBrush}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Tag="">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0,3" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MaxWidth="420" HorizontalAlignment="Left">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Margin" Value="0,14,0,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowMetadata}" Value="False">
                                                    <Setter Property="Margin" Value="0,3,0,0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrentUser}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            FontSize="11"
                                            Foreground="{StaticResource MessageMetadataBrush}"
                                            Text="{Binding HeaderText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowMetadata}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border
                                            MaxWidth="400"
                                            Padding="10,11"
                                            Background="{StaticResource MessageBubbleOtherBrush}"
                                            CornerRadius="13">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentUser}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource MessageBubbleOwnBrush}" />
                                                            <Setter Property="CornerRadius" Value="13,13,4,13" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="13"
                                                    Foreground="{StaticResource MessageTextOtherBrush}"
                                                    Text="{Binding Content}"
                                                    TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrentUser}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource MessageTextOwnBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border
                                                    Visibility="{Binding Type, Converter={StaticResource FileTypeVisibilityConverter}}"
                                                    Margin="0,8,0,0"
                                                    Padding="10,12"
                                                    CornerRadius="10"
                                                    BorderBrush="{StaticResource LightBorderBrush}"
                                                    BorderThickness="1"
                                                    Background="{StaticResource BackgroundBrush}"
                                                    MinWidth="220"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="FileMessage_MouseLeftButtonUp">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource FileIconBackgroundBrush}" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Type, Converter={StaticResource MessageTypeToFileTypeConverter}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AvatarTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Content, Converter={StaticResource FileNameExtractorConverter}}" FontWeight="650" FontSize="12" Foreground="{StaticResource ForegroundBrush}" />
                                                            <TextBlock Text="Shared file" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border
                        Grid.Row="2"
                        Padding="12"
                        Background="{StaticResource InputAreaBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <TextBox
                                    x:Name="MessageTextBox"
                                    Padding="11"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Foreground="{StaticResource ForegroundBrush}"
                                    KeyDown="MessageTextBox_KeyDown" />
                            </Border>
                            <Button
                                Grid.Column="1"
                                Margin="9,0,0,0"
                                Padding="14,10"
                                helpers:ControlHelper.CornerRadius="9"
                                Background="{StaticResource MessageBubbleOwnBrush}"
                                BorderThickness="0"
                                Click="SendButton_Click"
                                Content="Send"
                                Foreground="{StaticResource MessageTextOwnBrush}" />
                        </Grid>
                    </Border>
                </Grid>
                <Border
                    Grid.Column="1"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                    <DockPanel Margin="18,14">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="{StaticResource ForegroundBrush}"
                                Text="Shared Files" />
                            <TextBlock
                                Margin="0,3,0,12"
                                FontSize="10"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="PM file transfer UI" />
                            <Button
                                Padding="8,6"
                                helpers:ControlHelper.CornerRadius="8"
                                Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}"
                                Click="UploadFileButton_Click"
                                Content="+ Upload file"
                                Foreground="{StaticResource ForegroundBrush}" />
                            <Button
                                Margin="0,6,0,0"
                                Padding="8,6"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="ExportChatButton_Click"
                                Content="↓ Export chat"
                                Foreground="{StaticResource ForegroundBrush}" />
                        </StackPanel>
                        <ListBox
                            x:Name="FilesListBox"
                            Margin="0,14,0,0"
                            Background="{StaticResource SidebarBackgroundBrush}"
                            BorderThickness="0"
                            ItemsSource="{Binding PendingFiles, ElementName=Root}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5,7">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource ForegroundBrush}"
                                            Text="{Binding FileName}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="10"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="Pending server support" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
