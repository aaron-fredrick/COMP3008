<Window x:Name="Root" x:Class="Chat.Client.Polling.Views.PrivateMessageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Chat.Client.Shared.Controls;assembly=Chat.Client.Shared" xmlns:helpers="clr-namespace:Chat.Client.Shared.Helpers;assembly=Chat.Client.Shared" Title="Private Message" Height="560" Width="760" Background="Transparent" WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize">
    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="{StaticResource WindowBorderThickness}" CornerRadius="{StaticResource WindowCornerRadius}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions><controls:CustomTitleBar Grid.Row="0"/>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14"><StackPanel Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AvatarBackgroundBrush}" Margin="0,0,12,0"><Canvas Width="28" Height="28"><Path Data="{Binding RecipientId, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToRibbonPathConverter}}" Stroke="{StaticResource AvatarTextBrush}" StrokeThickness="1.8" Fill="Transparent"/></Canvas></Border><StackPanel><TextBlock x:Name="RecipientText" Foreground="{StaticResource ForegroundBrush}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Direct Message" FontSize="11" Foreground="{StaticResource MessageMetadataBrush}" Margin="0,2,0,0"/></StackPanel></StackPanel></Border>
                    <ListBox Grid.Row="1" x:Name="MessagesListBox" Tag="" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0" Padding="20,16" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid MaxWidth="420" HorizontalAlignment="Left"><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,14,0,0"/><Style.Triggers><DataTrigger Binding="{Binding ShowMetadata}" Value="False"><Setter Property="Margin" Value="0,3,0,0"/></DataTrigger><DataTrigger Binding="{Binding IsCurrentUser}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger></Style.Triggers></Style></Grid.Style><StackPanel><TextBlock Text="{Binding HeaderText}" FontSize="11" Foreground="{StaticResource MessageMetadataBrush}" Margin="0,0,0,4"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ShowMetadata}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Border Padding="10,11" CornerRadius="13" Background="{StaticResource MessageBubbleOtherBrush}" MaxWidth="400"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsCurrentUser}" Value="True"><Setter Property="Background" Value="{StaticResource MessageBubbleOwnBrush}"/><Setter Property="CornerRadius" Value="13,13,4,13"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MessageTextOtherBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCurrentUser}" Value="True"><Setter Property="Foreground" Value="{StaticResource MessageTextOwnBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="{StaticResource InputAreaBackgroundBrush}" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10"><TextBox x:Name="MessageTextBox" FontSize="13" Padding="11" Background="Transparent" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0" KeyDown="MessageTextBox_KeyDown"/></Border><Button Grid.Column="1" Content="Send" Margin="9,0,0,0" Padding="14,10" Background="{StaticResource MessageBubbleOwnBrush}" Foreground="{StaticResource MessageTextOwnBrush}" BorderThickness="0" Click="SendButton_Click" helpers:ControlHelper.CornerRadius="9"/></Grid></Border>
                </Grid>
                <Border Grid.Column="1" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"><DockPanel Margin="18,14"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Shared Files" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}"/><TextBlock Text="PM file transfer UI" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,12"/><Button Content="+ Upload file" Click="UploadFileButton_Click" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" Padding="8,6" helpers:ControlHelper.CornerRadius="8"/></StackPanel><ListBox x:Name="FilesListBox" Background="{StaticResource SidebarBackgroundBrush}" BorderThickness="0" Margin="0,14,0,0" ItemsSource="{Binding PendingFiles, ElementName=Root}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,7"><TextBlock Text="{Binding FileName}" Foreground="{StaticResource ForegroundBrush}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="Pending server support" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
            </Grid>
        </Grid>
    </Border>
</Window>
