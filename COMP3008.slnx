<Solution Description="Chat Application"
  Version="1.0.0">

  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
    <Platform Name="Any CPU" />
  </Configurations>

  <Folder Name="/Source/">

    <Project
      Path="src/Chat.Contracts/Chat.Contracts.csproj"
      DisplayName="Chat Contracts" />

    <Project
      Path="src/Chat.Server/Chat.Server.csproj"
      DisplayName="Chat Server">

      <BuildDependency Project="src/Chat.Contracts/Chat.Contracts.csproj" />

    </Project>

    <Project
      Path="src/Chat.Client.Shared/Chat.Client.Shared.csproj"
      DisplayName="Chat Client (Shared)">

      <BuildDependency Project="src/Chat.Contracts/Chat.Contracts.csproj" />

    </Project>

    <Project
      Path="src/Chat.Client.Duplex/Chat.Client.Duplex.csproj"
      DisplayName="Chat Client (Duplex)">

      <BuildDependency Project="src/Chat.Contracts/Chat.Contracts.csproj" />
      <BuildDependency Project="src/Chat.Client.Shared/Chat.Client.Shared.csproj" />

    </Project>

    <Project
      Path="src/Chat.Client.Polling/Chat.Client.Polling.csproj"
      DisplayName="Chat Client (Polling)">

      <BuildDependency Project="src/Chat.Contracts/Chat.Contracts.csproj" />

    </Project>

  </Folder>

  <Folder Name="/Tests/">

    <Project
      Path="tests/Chat.Server.Tests/Chat.Server.Tests.csproj"
      DisplayName="Chat Server Tests" />

    <Project
      Path="tests/Chat.Client.Tests/Chat.Client.Tests.csproj"
      DisplayName="Chat Client Tests" />

  </Folder>

</Solution>