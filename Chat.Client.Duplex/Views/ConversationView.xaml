<Window x:Class="Chat.Client.Duplex.Views.ConversationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Chat.Client.Duplex.Views"
        Title="Conversation (Duplex)" Height="600" Width="1000"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="{StaticResource MarginNormal}">
                <TextBlock x:Name="ChannelNameText" FontSize="{StaticResource FontSizeLarge}" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="{StaticResource MarginBottomLarge}" TextWrapping="Wrap"/>

                <TextBlock Text="Members" FontSize="{StaticResource FontSizeMedium}" FontWeight="Bold"
                           Foreground="{StaticResource ForegroundBrush}" Margin="{StaticResource MarginBottomNormal}"/>
                <ListBox x:Name="MembersListBox" Background="{StaticResource SecondaryBackgroundBrush}"
                         Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" Height="200"
                         MouseDoubleClick="MembersListBox_MouseDoubleClick"/>

                <TextBlock Text="Shared Files" FontSize="{StaticResource FontSizeMedium}" FontWeight="Bold"
                           Foreground="{StaticResource ForegroundBrush}" Margin="{StaticResource MarginTopLarge}"/>
                <ListBox x:Name="FilesListBox" Background="{StaticResource SecondaryBackgroundBrush}"
                         Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" Height="120"
                         MouseDoubleClick="FilesListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="{StaticResource PaddingSmall}">
                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource ForegroundBrush}" FontWeight="Bold" FontSize="{StaticResource FontSizeNormal}"/>
                                <TextBlock Foreground="#aaaaaa" FontSize="{StaticResource FontSizeSmall}">
                                    <Run Text="{Binding UploaderId}"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding UploadedAt, StringFormat='{}{0:HH:mm}'}"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button x:Name="ShareFileButton" Content="Share File" FontSize="{StaticResource FontSizeNormal}" Padding="{StaticResource ButtonPaddingSmall}" Margin="{StaticResource MarginTopNormal}"
                        Background="{StaticResource AccentBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0"
                        Cursor="Hand" Click="ShareFileButton_Click"/>

                <Button x:Name="LeaveButton" Content="Leave Channel" FontSize="{StaticResource FontSizeNormal}" Padding="{StaticResource ButtonPaddingSmall}" Margin="{StaticResource MarginTopLarge}"
                        Background="{StaticResource ErrorBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0"
                        Cursor="Hand" Click="LeaveButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Chat Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Messages -->
            <ListBox x:Name="MessagesListBox" Grid.Row="0" Background="{StaticResource BackgroundBrush}"
                     Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="{StaticResource MarginNormal}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            <!-- Input Area -->
            <Border Grid.Row="1" Background="{StaticResource SecondaryBackgroundBrush}" Padding="{StaticResource PaddingMedium}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageTextBox" Grid.Column="0" FontSize="{StaticResource FontSizeMedium}" Padding="{StaticResource PaddingNormal}"
                             Background="{StaticResource SecondaryBackgroundBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    <Button x:Name="SendButton" Grid.Column="1" Content="Send" FontSize="{StaticResource FontSizeMedium}" Padding="{StaticResource ButtonPaddingLarge}"
                            Background="{StaticResource AccentBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0"
                            Cursor="Hand" Margin="10,0,0,0" Click="SendButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
