<Window x:Name="Root" x:Class="Chat.Client.Duplex.Views.PrivateMessageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Chat.Client.Shared.Controls;assembly=Chat.Client.Shared" xmlns:helpers="clr-namespace:Chat.Client.Shared.Helpers;assembly=Chat.Client.Shared" Title="Private Message (Duplex)" Height="560" Width="760" Background="Transparent" WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize">
<Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="{StaticResource WindowBorderThickness}" CornerRadius="{StaticResource WindowCornerRadius}"><Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions><controls:CustomTitleBar Grid.Row="0"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14"><StackPanel Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AvatarBackgroundBrush}" Margin="0,0,12,0"><Canvas Width="28" Height="28"><Path Data="{Binding RecipientId, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToRibbonPathConverter}}" Stroke="{StaticResource AvatarTextBrush}" StrokeThickness="1.8" Fill="Transparent"/></Canvas></Border><StackPanel><TextBlock x:Name="RecipientText" Foreground="{StaticResource ForegroundBrush}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Direct Message" FontSize="11" Foreground="{StaticResource MessageMetadataBrush}" Margin="0,2,0,0"/></StackPanel></StackPanel></Border><ListBox Grid.Row="1" x:Name="MessagesListBox" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0" Padding="20,16"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding HeaderText}" FontSize="11" Foreground="{StaticResource MessageMetadataBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ShowMetadata}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Border Padding="10,11" CornerRadius="13" Background="{StaticResource MessageBubbleOtherBrush}"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsCurrentUser}" Value="True"><Setter Property="Background" Value="{StaticResource MessageBubbleOwnBrush}"/><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{StaticResource MessageTextOtherBrush}"/></Border></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Row="2" Background="{StaticResource InputAreaBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="MessageTextBox" Grid.Column="0" Padding="11" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" KeyDown="MessageTextBox_KeyDown"/><Button Grid.Column="1" Content="Send" Margin="9,0,0,0" Padding="14,10" Click="SendButton_Click" Background="{StaticResource MessageBubbleOwnBrush}" Foreground="{StaticResource MessageTextOwnBrush}" BorderThickness="0" helpers:ControlHelper.CornerRadius="9"/></Grid></Border></Grid><Border Grid.Column="1" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"><DockPanel Margin="18,14"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Shared Files" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}"/><TextBlock Text="PM file transfer UI" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,12"/><Button Content="+ Upload file" Click="UploadFileButton_Click" Padding="8,6" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" helpers:ControlHelper.CornerRadius="8"/></StackPanel><ListBox x:Name="FilesListBox" ItemsSource="{Binding PendingFiles, ElementName=Root}" Background="{StaticResource SidebarBackgroundBrush}" BorderThickness="0" Margin="0,14,0,0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,7"><TextBlock Text="{Binding FileName}" Foreground="{StaticResource ForegroundBrush}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="Pending server support" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border></Grid></Grid></Border></Window>
